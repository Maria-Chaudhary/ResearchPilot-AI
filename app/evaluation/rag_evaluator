"""
Lightweight, dependency-free evaluation utilities for ResearchPilot AI.

Retrieval metrics require a labelled set of relevant chunk IDs. Answer
metrics below are lexical diagnostics only; they are NOT a true semantic
faithfulness judge and should be paired with human review or an LLM judge.
"""
from __future__ import annotations

import math
import re
from typing import Any, Iterable


def _identity(item: Any) -> str:
    if isinstance(item, dict):
        value = item.get("chunk_id", item.get("id"))
        return str(value) if value is not None else ""
    return str(item)


def evaluate_retrieval(
    retrieved: list[Any],
    relevant_chunk_ids: Iterable[Any],
    k_values: tuple[int, ...] = (1, 3, 5, 10),
) -> dict[str, Any]:
    """
    Compute Precision@K, Recall@K, reciprocal rank, and nDCG@K.

    `relevant_chunk_ids` must be ground-truth labels prepared by a person
    for each evaluation question. Metrics are not meaningful without labels.
    """
    relevant = {str(value) for value in relevant_chunk_ids}
    ranked_ids = [_identity(item) for item in retrieved]
    ranked_ids = [value for value in ranked_ids if value]

    if not relevant:
        raise ValueError("At least one relevant chunk ID is required.")

    first_rank = next(
        (rank for rank, value in enumerate(ranked_ids, start=1) if value in relevant),
        None,
    )
    result: dict[str, Any] = {
        "relevant_count": len(relevant),
        "retrieved_count": len(ranked_ids),
        "mrr": 1.0 / first_rank if first_rank else 0.0,
    }

    for k in k_values:
        if isinstance(k, bool) or not isinstance(k, int) or k < 1:
            raise ValueError("Every k value must be a positive integer.")
        top = ranked_ids[:k]
        hits = sum(1 for value in top if value in relevant)
        result[f"precision@{k}"] = hits / k
        result[f"recall@{k}"] = hits / len(relevant)

        dcg = sum(
            1.0 / math.log2(rank + 1)
            for rank, value in enumerate(top, start=1)
            if value in relevant
        )
        ideal_hits = min(len(relevant), k)
        idcg = sum(
            1.0 / math.log2(rank + 1)
            for rank in range(1, ideal_hits + 1)
        )
        result[f"ndcg@{k}"] = dcg / idcg if idcg else 0.0

    return result


def evaluate_answer_heuristics(
    question: str,
    answer: str,
    evidence: str,
) -> dict[str, Any]:
    """
    Return transparent lexical proxies, not model-judged truth scores.

    `evidence_term_coverage` estimates how much answer vocabulary occurs
    in evidence. `question_term_coverage` estimates lexical relevance.
    These scores cannot detect paraphrases or prove factual support.
    """
    def terms(text: str) -> set[str]:
        return {
            token.lower()
            for token in re.findall(r"[A-Za-z0-9][A-Za-z0-9_-]*", text or "")
            if len(token) > 2
        }

    answer_terms = terms(answer)
    evidence_terms = terms(evidence)
    question_terms = terms(question)

    evidence_coverage = (
        len(answer_terms & evidence_terms) / len(answer_terms)
        if answer_terms else 0.0
    )
    question_coverage = (
        len(answer_terms & question_terms) / len(answer_terms)
        if answer_terms else 0.0
    )

    return {
        "evidence_term_coverage_proxy": round(evidence_coverage, 4),
        "question_term_coverage_proxy": round(question_coverage, 4),
        "answer_term_count": len(answer_terms),
        "evaluation_type": "heuristic_lexical_proxy_not_semantic_judgment",
    }

